// Maestro — YouTube Intelligence & Production Operating System
// Persistent knowledge graph + production pipeline state

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Core entity: a content production project (one video) ──────────────────────
model Project {
  id           String   @id @default(cuid())
  title        String
  niche        String
  status       String   @default("discovery") // discovery | research | scripting | packaging | production | publish | live | archived
  stage        String   @default("opportunity") // opportunity | dossier | interview | outline | expanded | draft | factcheck | final | trifecta | blueprint | assets | metadata | scheduled | published
  brief        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  opportunity     Opportunity?
  dossier         ResearchDossier?
  interviews      CreatorInterview[]
  scripts         Script[]
  trifecta        HolyTrifecta?
  blueprint       EditorBlueprint?
  assets          Asset[]
  publishMetadata PublishMetadata?
  metrics         PerformanceMetric[]
  agentRuns       AgentRun[]
  approvals       ApprovalGate[]
  activities      ActivityLog[]
  competitorVideos CompetitorVideo[]
  interviewSession InterviewSession?
  thumbnailBriefs  ThumbnailBrief[]
  productionScenes ProductionScene[]
  trendSignals     TrendSignal[]
  productionPlans  ProductionPlan[]

  @@map("projects")
}

// ── Opportunity Hunter output ──────────────────────────────────────────────────
model Opportunity {
  id             String   @id @default(cuid())
  projectId      String   @unique
  title          String
  niche          String
  angle          String
  opportunityScore Float
  scoreBreakdown String   // JSON: { demand, competition, freshness, audienceFit, monetization, ... }
  sources        String   // JSON array of source refs
  competitors    String   // JSON array
  audienceSignals String  // JSON
  trends         String   // JSON
  confidence     String   @default("medium") // low | medium | high
  status         String   @default("new") // new | accepted | rejected | archived
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("opportunities")
}

// ── Research Analyst dossier ───────────────────────────────────────────────────
model ResearchDossier {
  id              String   @id @default(cuid())
  projectId       String   @unique
  summary         String
  marketData      String   // JSON
  competitors     String   // JSON
  audienceInsights String  // JSON
  news            String   // JSON
  references      String   // JSON
  knowledgeGaps   String   // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("research_dossiers")
}

// ── Creator interview (human expertise capture) ───────────────────────────────
model CreatorInterview {
  id        String   @id @default(cuid())
  projectId String
  question  String
  answer    String
  themeTag  String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("creator_interviews")
}

// ── Creator voice & style profile (learned, singleton-ish) ────────────────────
model CreatorProfile {
  id                String   @id @default(cuid())
  voiceProfile      String   // JSON: tone, pacing, vocabulary, signatures
  styleGuidelines   String   // JSON
  expertise         String   // JSON array
  recurringThemes   String   // JSON
  toneSamples       String   // JSON
  distinctivenessScore Float @default(0)
  updatedAt         DateTime @updatedAt

  @@map("creator_profile")
}

// ── Script versions (iterative stages) ────────────────────────────────────────
model Script {
  id        String   @id @default(cuid())
  projectId String
  stage     String   // outline | expanded_outline | draft | final
  content   String
  version   Int      @default(1)
  notes     String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("scripts")
}

// ── Holy Trifecta: title + thumbnail + hook (unified) ─────────────────────────
model HolyTrifecta {
  id                String   @id @default(cuid())
  projectId         String   @unique
  title             String
  thumbnailStrategy String   // JSON: concept, text overlay, focal, color, emotion
  openingHook       String
  rationale         String
  variants          String   // JSON array of alternates
  expectationMatch  String   // how title/thumbnail/hook align
  createdAt         DateTime @default(now())
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("holy_trifectas")
}

// ── Editor blueprint (timestamped production plan) ────────────────────────────
model EditorBlueprint {
  id        String   @id @default(cuid())
  projectId String   @unique
  segments  String   // JSON: [{ timecode, section, broll, graphics, captions, transitions, retentionNotes }]
  totalDuration String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("editor_blueprints")
}

// ── Supporting assets ─────────────────────────────────────────────────────────
model Asset {
  id        String   @id @default(cuid())
  projectId String
  type      String   // diagram | infographic | social | repurposed_short | repurposed_blog | thumbnail_concept
  title     String
  prompt    String
  status    String   @default("pending") // pending | generating | ready | failed
  url       String?
  spec      String   // JSON
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("assets")
}

// ── Upload metadata ───────────────────────────────────────────────────────────
model PublishMetadata {
  id            String   @id @default(cuid())
  projectId     String   @unique
  description   String
  chapters      String   // JSON
  tags          String   // JSON
  pinnedComment String?
  playlist      String?
  publishAt     DateTime?
  endScreen     String?  // JSON
  createdAt     DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("publish_metadata")
}

// ── Post-publication performance ──────────────────────────────────────────────
model PerformanceMetric {
  id              String   @id @default(cuid())
  projectId       String
  ctr             Float
  retention       Float
  avgViewDuration Float
  impressions     Int
  views           Int
  trafficSources  String   // JSON
  revenue         Float
  engagement      Float
  lessons         String   // JSON: learned patterns
  recordedAt      DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("performance_metrics")
}

// ── Agent execution log ───────────────────────────────────────────────────────
model AgentRun {
  id         String   @id @default(cuid())
  projectId  String?
  agentType  String
  status     String   @default("running") // running | succeeded | failed
  input      String   // JSON
  output     String   // JSON
  tokens     Int      @default(0)
  durationMs Int      @default(0)
  error      String?
  createdAt  DateTime @default(now())
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([agentType])
  @@map("agent_runs")
}

// ── Human-in-the-loop approval gates ──────────────────────────────────────────
model ApprovalGate {
  id        String   @id @default(cuid())
  projectId String
  stage     String   // opportunity | dossier | outline | draft | final | trifecta | blueprint | metadata | publish
  agentType String
  payload   String   // JSON summary of what's being approved
  status    String   @default("pending") // pending | approved | rejected | revised
  feedback  String?
  decidedAt DateTime?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("approval_gates")
}

// ── Knowledge graph (persistent intelligence) ─────────────────────────────────
model KnowledgeNode {
  id        String   @id @default(cuid())
  type      String   // Semantic memory + intelligence: principle | lesson | pattern | mistake | experiment | framework | evidence | relationship | audience_reaction | audience_insight | creator_voice | research | editorial | history | competitor | story | opinion | analogy | experience | winning_hook | winning_title | thumbnail_style | editing_style | performance_history
  label     String
  content   String
  weight    Float    @default(1)
  projectId String?
  // Memory lifecycle: observation → pattern → lesson → principle → constitution
  lifecycle    String   @default("observation") // observation | pattern | lesson | principle | constitution
  lifecycleMeta String  @default("{}") // JSON: { promotedAt, promotedFrom, evidence, confidence }
  createdAt DateTime @default(now())

  edgesFrom KnowledgeEdge[] @relation("KnowledgeEdgeSource")
  edgesTo   KnowledgeEdge[] @relation("KnowledgeEdgeTarget")

  @@index([type])
  @@index([lifecycle])
  @@map("knowledge_nodes")
}

model KnowledgeEdge {
  id       String @id @default(cuid())
  sourceId String
  targetId String
  relation String
  weight   Float  @default(1)
  source   KnowledgeNode @relation("KnowledgeEdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target   KnowledgeNode @relation("KnowledgeEdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@map("knowledge_edges")
}

// ── Activity log (system feed) ────────────────────────────────────────────────
model ActivityLog {
  id        String   @id @default(cuid())
  projectId String?
  type      String   // agent | approval | system | creator
  message   String
  meta      String   // JSON
  createdAt DateTime @default(now())
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("activity_logs")
}

// ════════════════════════════════════════════════════════════════════════════
// PHASE 2 — Real intelligence, production & publishing models
// ════════════════════════════════════════════════════════════════════════════

// ── Raw trend/intelligence signals gathered by the Opportunity Intelligence Engine
// One row per discrete signal (a YouTube video, a Reddit thread, a Trends point, a news item)
model TrendSignal {
  id          String   @id @default(cuid())
  projectId   String?
  niche       String
  source      String   // youtube | google_trends | reddit | news | search | competitor
  title       String
  url         String
  snippet     String
  metric      String?  // e.g. "views", "upvotes", "interest", "subs"
  metricValue Float?
  momentum    String?  // rising | peaking | stable | declining
  capturedAt  DateTime @default(now())
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([niche])
  @@index([source])
  @@map("trend_signals")
}

// ── Competitor Video Intelligence: deep analysis of a single competing video
model CompetitorVideo {
  id            String   @id @default(cuid())
  projectId     String?
  niche         String
  url           String
  channel       String
  title         String
  views         Int      @default(0)
  likes         Int      @default(0)
  comments      Int      @default(0)
  publishedAt   String?
  durationSec   Int      @default(0)
  // analysis JSON
  titleAnalysis String   // JSON: { pattern, hooks, curiosityTriggers, length, sentiment }
  thumbnailAnalysis String // JSON: { composition, focal, textOverlay, emotion, colorMood, readability }
  transcriptSummary String // JSON: { structure, keyPoints, retentionPattern, callsToAction }
  commentInsights String  // JSON: { topQuestions, painPoints, praises, objections, audienceQuestions[] }
  winningPatterns String  // JSON: [{ pattern, whyItWorked, applicability }]
  performanceScore Float  @default(0) // normalized 0-100
  capturedAt    DateTime @default(now())
  project       Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([niche])
  @@map("competitor_videos")
}

// ── Creator Voice DNA: expanded, learned voice profile (rich JSON)
// Single active row (the latest). Each extraction creates a new row; the API returns the newest.
model VoiceDNA {
  id              String   @id @default(cuid())
  writingStyle    String   // JSON: { avgSentenceLength, structure, complexity, register }
  vocabulary      String   // JSON: { signaturePhrases[], favoriteWords[], jargon[], avoidedTerms[] }
  storytellingPatterns String // JSON: { openings[], callbacks[], frameworks[], transitions[] }
  humor           String   // JSON: { style, frequency, type, examples[] }
  pacing          String   // JSON: { wordsPerMinute, pausePattern, sectionLength, rhythm }
  contentPreferences String // JSON: { preferredFormats[], idealLength, structurePreference, depthLevel }
  emotionalTone   String   // JSON: { defaultTone, range, shifts, intensity }
  uniquenessScore Float    @default(0)
  sourceSamples   String   // JSON: [{ from, excerpt }] — provenance
  sampleCount     Int      @default(0)
  createdAt       DateTime @default(now())

  @@map("voice_dna")
}

// ── Conversational Interview Session state
model InterviewSession {
  id          String   @id @default(cuid())
  projectId   String   @unique
  status      String   @default("active") // active | completed
  topicsCovered String  // JSON: [{ topic, covered: bool, depth: 0-1 }]
  questions   String   // JSON: [{ id, question, intent, topic, asked: bool }]
  extracted   String   // JSON: [{ type: story|opinion|framework|example|expertise, content, themeTag }]
  turnCount   Int      @default(0)
  startedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("interview_sessions")
}

// ── Thumbnail Brief: detailed director brief + AI generation prompts
model ThumbnailBrief {
  id              String   @id @default(cuid())
  projectId       String
  concept         String
  visualLayout    String   // JSON: { composition, focalSubject, background, depth, ruleOfThirds }
  textOverlay     String   // JSON: { text, font, size, position, contrast }
  emotionalTriggers String // JSON: [{ trigger, how }]
  colorMood       String   // JSON: { palette[], mood, contrast }
  mobileReadability Float  // 0-100 score
  readabilityNotes String
  aiPrompts       String   // JSON: [{ variant, prompt, size, styleNotes }]
  generatedImageUrl String? // base64 data URL or path when generated
  status          String   @default("brief") // brief | generating | generated | failed
  createdAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("thumbnail_briefs")
}

// ── Production Scene: granular scene-by-scene editor instructions
model ProductionScene {
  id           String   @id @default(cuid())
  projectId    String
  sceneNumber  Int
  timecode     String   // "0:00-0:30"
  section      String
  visualDescription String
  brollSuggestions String  // JSON: [{ description, source, duration }]
  motionGraphics String    // JSON: [{ type, description, trigger }]
  editorInstructions String
  captions     String   // JSON: [{ text, timing, style }]
  transitions  String   // JSON: [{ from, to, type }]
  assetRequirements String // JSON: [{ type, description, priority }]
  retentionNotes String
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("production_scenes")
}

// ── YouTube OAuth connection (per-creator; single active row)
model YouTubeConnection {
  id            String   @id @default(cuid())
  channelName   String?
  channelId     String?
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  connectedAt   DateTime?
  status        String   @default("disconnected") // disconnected | connected | expired | error
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("youtube_connections")
}


// ════════════════════════════════════════════════════════════════════════════
// PHASE 3 — AI Media Operating System
// Capability Registry · Extension Marketplace · Creator Identity Engine
// Output Connectors · Director AI · Capability Graph
// ════════════════════════════════════════════════════════════════════════════

// ── Capability: a discrete, composable production capability
// Everything the OS can do is a capability (research, script_writing, thumbnail_gen, etc.)
model Capability {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "research.signals", "script.writing", "thumbnail.generation"
  name        String
  description String
  category    String   // intelligence | creative | production | distribution | learning | identity | safety
  inputs      String   // JSON: required input types (Media Primitives)
  outputs     String   // JSON: produced output types (Media Primitives)
  cost        String   @default("low") // low | medium | high
  latency     String   @default("fast") // fast | medium | slow
  latencySec  Int      @default(0) // estimated seconds (0 = unknown)
  quality     String   @default("good") // draft | good | high | production
  qualityScore Float   @default(0.7) // 0-1 normalized quality
  costUsd     Float    @default(0) // estimated cost in USD per invocation
  source      String   @default("builtin") // builtin | extension:<extId>
  extensionId String?  // null if builtin
  agentType   String?  // the agent that fulfills this capability (if builtin)
  status      String   @default("active") // active | disabled
  // Capability Contract: authenticity + DNA support
  authenticitySupport String @default("[]") // JSON: DNA types this capability supports (e.g. ["voice","writing"])
  improvesDNA  String   @default("[]") // JSON: DNA types this capability improves/provides reference for
  requires     String   @default("[]") // JSON: required permissions/scopes
  provider     String?  // the providing service (e.g. "Voice Studio", "ElevenLabs", "Runway")
  createdAt   DateTime @default(now())

  @@index([category])
  @@map("capabilities")
}

// ── Extension: a bundle of capabilities + agents, declared via a manifest
// Extensions are "installed" into the OS. Builtin extensions ship with the core.
model Extension {
  id          String   @id @default(cuid())
  extId       String   @unique // manifest id, e.g. "core-intelligence", "voice-studio"
  name        String
  version     String
  description String
  publisher   String   @default("Maestro")
  manifest    String   // JSON: full manifest (capabilities[], permissions[], agents[], requirements)
  capabilities String  // JSON: array of capability keys provided
  agents      String   // JSON: array of agent names declared
  permissions String   // JSON: array of permission scopes
  category    String   @default("studio") // core | studio | connector | pack
  status      String   @default("installed") // available | installed | disabled
  installedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([status])
  @@map("extensions")
}

// ── Creator Identity Engine: the unified identity layer
// Augments Voice DNA with beliefs, experiences, stories, frameworks, values.
// Every generated script is grounded in this identity.
model CreatorIdentity {
  id                  String   @id @default(cuid())
  mission             String?  // the creator's overarching mission
  beliefs             String   // JSON: [{ belief, strength }]
  experiences         String   // JSON: [{ area, years, notable }]
  stories             String   // JSON: [{ title, summary, themeTag }]
  frameworks          String   // JSON: [{ name, description }] — mental models the creator uses
  analogies           String   // JSON: string[] — recurring analogies
  humor               String   // JSON: { style, frequency, examples }
  values              String   // JSON: string[] — non-negotiable values
  vocabulary          String   // JSON: { signaturePhrases, favoriteWords, avoidedTerms }
  audienceExpectations String  // JSON: { whatTheyComeFor, whatTheyTrust, whatTheyReject }
  voiceDNAId          String?  // link to latest VoiceDNA
  authenticityScore   Float    @default(0) // 0-1, how well-captured the identity is
  extendedDimensions  String   @default("{}") // JSON: visualLanguage, editingStyle, musicTaste, brandLanguage, relationships, products, companies, history, goals, thinkingStyle, reasoning, cameraStyle
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  @@map("creator_identities")
}

// ── Output Channel: a distribution connector (YouTube is one of many)
model OutputChannel {
  id          String   @id @default(cuid())
  key         String   @unique // youtube | tiktok | instagram | x | linkedin | substack | podcast | blog
  name        String
  icon        String   // lucide icon name
  category    String   // video | short | social | text | audio
  description String
  status      String   @default("available") // available | connected | error
  config      String   // JSON: connection config (tokens, handles, etc.)
  connectedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("output_channels")
}

// ── Production Plan: a dynamic plan compiled by the Director AI
// The Director takes a creative intent + discovers available capabilities → compiles a plan
model ProductionPlan {
  id          String   @id @default(cuid())
  projectId   String?
  intent      String   // the creative intent (natural language)
  targetChannel String? // which output channel (youtube, tiktok, etc.)
  steps       String   // JSON: [{ stepKey, capabilityKey, capabilityName, agentType, inputs, outputs, rationale, status }]
  rationale   String   // why this plan (the Director's reasoning)
  capabilitiesUsed String // JSON: array of capability keys
  status      String   @default("draft") // draft | approved | running | completed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("production_plans")
}

// ════════════════════════════════════════════════════════════════════════════
// PHASE 4 — Authenticity Engine + Media DNA + Semantic Memory + Developer SDK
// The differentiator: the system understands identity and authenticity better
// than anyone. Every artifact is scored; publishing is blocked if authenticity drops.
// ════════════════════════════════════════════════════════════════════════════

// ── Media DNA: the reference models the Authenticity Engine checks against.
// Generalizes Voice DNA into 8 DNA types. Each extension can improve one or more.
model MediaDNA {
  id        String   @id @default(cuid())
  type      String   // voice | visual | writing | editing | story | reasoning | brand | teaching
  content   String   // JSON: type-specific DNA profile
  source    String   @default("builtin") // builtin | extension:<extId> | manual
  sourceRef String?  // e.g. voice DNA id, extension id
  confidence Float   @default(0.5) // 0-1, how confident we are in this model
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([type])
  @@map("media_dna")
}

// ── Authenticity Score: every artifact gets scored on 7 dimensions.
// If overall < threshold OR a blocking dimension fails, publish is refused.
model AuthenticityScore {
  id                  String   @id @default(cuid())
  projectId           String?
  artifactType        String   // script | trifecta | thumbnail | scene | full_production
  artifactRef         String?  // id of the specific artifact (script id, trifecta id, etc.)
  overall             Float    // 0-100 composite
  voice               Float    // does it match the Voice DNA?
  reasoning           Float    // does it match the creator's reasoning/thinking style?
  humor               Float    // does it match the creator's humor?
  vocabulary          Float    // does it use the creator's vocabulary?
  editing             Float    // does the editing/structure match?
  visualIdentity      Float    // does the visual language match?
  audienceExpectation Float    // does it meet what the audience expects?
  passed              Boolean  @default(false) // overall >= threshold AND no blocking dimension failed
  blockingReason      String?  // why it was blocked (if !passed)
  threshold           Float    @default(70) // the threshold this check used
  rationale           String?  // LLM explanation of the scores
  createdAt           DateTime @default(now())

  @@index([projectId, artifactType])
  @@index([passed])
  @@map("authenticity_scores")
}

// ════════════════════════════════════════════════════════════════════════════
// PHASE 5 — Media Primitives + Capability Contracts + Pervasive Authenticity
// Format-independent creative building blocks. The kernel operates on these,
// not on "YouTube videos" or "tweets". Connectors transform primitives into
// platform-specific outputs.
// ════════════════════════════════════════════════════════════════════════════

// ── Media Primitive: a reusable creative building block, independent of format.
// The creator isn't producing videos. They're producing ideas. Everything else
// is a transformation. Primitives flow through capabilities and become outputs.
model MediaPrimitive {
  id          String   @id @default(cuid())
  type        String   // idea | claim | story | evidence | scene | voice_performance | visual_asset | audience_reaction | knowledge_asset
  title       String
  content     String   // the primitive's content (text, JSON spec, etc.)
  format      String   @default("text") // text | json | markdown | audio_url | image_url | video_url
  source      String   @default("creator") // creator | agent:<type> | extension:<id> | research
  sourceRef   String?  // project id, agent run id, etc.
  projectId   String?
  parentId    String?  // for derived primitives (a claim derived from a story)
  provenance  String   @default("[]") // JSON: [{ step, capability, timestamp }] — how this primitive was produced
  tags        String   @default("[]") // JSON string array
  status      String   @default("draft") // draft | ready | published | archived
  authenticityScore Float @default(0) // 0-100, last authenticity check
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([projectId])
  @@map("media_primitives")
}

// ════════════════════════════════════════════════════════════════════════════
// PHASE 6 — Creative Constitution + Creative Policies + Provenance
// The "why" layer. The Constitution encodes principles (not just style).
// Authenticity becomes Constitutional AI — scoring alignment with principles.
// ════════════════════════════════════════════════════════════════════════════

// ── Constitution Principle: a machine-readable creative principle
// Categories: truthfulness | teaching | tone | business | audience | editing
model ConstitutionPrinciple {
  id          String   @id @default(cuid())
  category    String   // truthfulness | teaching | tone | business | audience | editing
  principle   String   // the rule, e.g. "Never fabricate evidence"
  rationale   String   // why this principle exists
  enforcement String   @default("block") // block | warn | log
  examples    String   @default("[]") // JSON: example violations
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("constitution_principles")
}

// ── Constitution Violation: logged when an artifact breaks a principle
model ConstitutionViolation {
  id            String   @id @default(cuid())
  principleId   String?
  category      String
  principle     String   // denormalized for quick display
  artifactType  String   // script | trifecta | thumbnail | scene | voice | video | metadata
  artifactRef   String?
  projectId     String?
  severity      String   // block | warn | log
  reason        String   // what triggered the violation
  context       String   @default("{}") // JSON: the offending excerpt + surrounding context
  status        String   @default("open") // open | resolved | overridden
  resolution    String?  // JSON: how it was resolved
  createdAt     DateTime @default(now())

  @@index([status])
  @@index([projectId])
  @@map("constitution_violations")
}

// ── Creative Policy: a runtime rule that governs capability execution
// Different from DNA (describes identity) — policies define boundaries.
// e.g. "Never clone my voice unless I explicitly approve"
model CreativePolicy {
  id          String   @id @default(cuid())
  name        String   // short name
  rule        String   // the policy rule (natural language)
  scope       String   // voice | video | publish | research | opinion | all
  condition   String   @default("{}") // JSON: structured condition (capability key, threshold, etc.)
  action      String   @default("require_approval") // require_approval | block | allow | log
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scope])
  @@map("creative_policies")
}

// ════════════════════════════════════════════════════════════════════════════
// PHASE 7 — Trust Engine + Artifact Envelope + Self-Improving Memory
// The product isn't AI generation (commodity). It's identity & authenticity
// infrastructure. Every artifact carries a trust profile + provenance envelope.
// ════════════════════════════════════════════════════════════════════════════

// ── Trust Profile: every artifact gets a trust profile (the platform's biggest differentiator)
model TrustProfile {
  id                String   @id @default(cuid())
  projectId         String?
  artifactType      String   // script | trifecta | thumbnail | scene | voice | video | full_production
  artifactRef       String?
  trustScore        Float    // 0-100 composite trust
  evidenceScore     Float    // how well-supported by evidence
  sourceDiversity   Float    // how many independent sources
  hallucinationRisk Float    // 0-100 (lower = safer)
  authenticityScore Float    // from the Authenticity Engine
  constitutionAlignment Float // from the Constitution check
  creatorConfidence Float    // creator's stated confidence
  audienceConfidence Float   // projected audience confidence
  reviewStatus      String   @default("pending") // pending | reviewed | approved | rejected
  riskFactors       String   @default("[]") // JSON: [{ factor, severity }]
  sources           String   @default("[]") // JSON: [{ type, url, reliability }]
  createdAt         DateTime @default(now())

  @@index([projectId, artifactType])
  @@index([reviewStatus])
  @@map("trust_profiles")
}

// ── Artifact Envelope: every artifact carries its full metadata envelope
// authenticity + constitutionAlignment + confidence + provenance + sources +
// identityVersion + modelVersion + generatedBy
model ArtifactEnvelope {
  id                  String   @id @default(cuid())
  projectId           String?
  artifactType        String
  artifactRef         String?
  authenticityScore   Float    @default(0)
  constitutionAlignment Float  @default(0)
  confidence          Float    @default(0) // 0-1, how confident the system is
  provenance          String   @default("[]") // JSON: chain of sources
  sources             String   @default("[]") // JSON: [{ type, url, reliability }]
  identityVersion     String?  // which Creator Identity version was used
  modelVersion        String?  // which model/provider generated this
  generatedBy         String   // creator | agent:<type> | extension:<id> | capability:<key>
  trustProfileId      String?  // link to TrustProfile
  createdAt           DateTime @default(now())

  @@index([projectId, artifactType])
  @@map("artifact_envelopes")
}

// ════════════════════════════════════════════════════════════════════════════
// PHASE 8 — The Intelligence Substrate: Creator Mind, Knowledge Graph,
// Reasoning Trace, Audiences, Goals, Creative Intent
// The platform maintains a living model of the creator's mind.
// Everything else is an expression of that model.
// ════════════════════════════════════════════════════════════════════════════

// ── Goal: what the creator is trying to accomplish (the Director optimizes toward these)
model Goal {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   // growth | product | teaching | trust | revenue | community | retention
  priority    String   @default("medium") // low | medium | high
  status      String   @default("active") // active | achieved | abandoned
  targetMetric String? // e.g. "100k subscribers", "8% CTR"
  progress    Float    @default(0) // 0-1
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@map("goals")
}

// ── Audience: multiple audience models (authenticity is partly audience-dependent)
model Audience {
  id              String   @id @default(cuid())
  name            String   // e.g. "Senior engineers", "Beginners", "Startup founders"
  description     String?
  vocabulary      String   @default("[]") // JSON: terms this audience uses
  misconceptions  String   @default("[]") // JSON: common misunderstandings
  interests       String   @default("[]") // JSON: what they care about
  objections      String   @default("[]") // JSON: what they push back on
  trustSignals    String   @default("[]") // JSON: what builds trust with them
  preferredExamples String @default("[]") // JSON: examples that resonate
  attentionSpan   String   @default("medium") // short | medium | long
  expertiseLevel  String   @default("intermediate") // beginner | intermediate | advanced | expert
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("audiences")
}

// ── Reasoning Trace: auditable decision trail for every artifact
// Records: intent → capabilities selected → evidence used → identity constraints →
// constitution checks → trust analysis → human approvals → final artifact
model ReasoningTrace {
  id          String   @id @default(cuid())
  projectId   String?
  artifactType String
  artifactRef String?
  intent      String   // the creative intent that started this
  steps       String   @default("[]") // JSON: [{ step, description, input, output, timestamp }]
  capabilitiesUsed String @default("[]") // JSON: capability keys
  evidenceUsed String   @default("[]") // JSON: evidence node refs
  identityConstraints String @default("[]") // JSON: which identity dimensions were applied
  constitutionChecks String @default("[]") // JSON: constitution check results
  trustResult String   @default("{}") // JSON: trust profile summary
  humanApprovals String @default("[]") // JSON: [{ stage, decision, feedback, timestamp }]
  finalArtifact String? // the final artifact content (or ref)
  createdAt   DateTime @default(now())

  @@index([projectId, artifactType])
  @@map("reasoning_traces")
}

// ════════════════════════════════════════════════════════════════════════════
// PHASE 9 — Creator Venture Studio
// The platform maximizes the economic value of a creator's unique abilities
// while remaining authentic. The optimization target is the creator's long-term
// success, not better videos.
// ════════════════════════════════════════════════════════════════════════════

// ── Creator Venture: the creator as a startup
model CreatorVenture {
  id              String   @id @default(cuid())
  stage           String   @default("seed") // seed | early | growth | mature | scale
  vision          String?  // the creator's long-term vision
  projectedValue  Float    @default(0) // estimated venture value (annual revenue potential)
  revenueStreams  String   @default("[]") // JSON: [{ type, currentMonthly, potentialMonthly }]
  growthStrategy  String   @default("[]") // JSON: [{ lever, description, impact }]
  executionCapacity String @default("{}") // JSON: { hoursPerWeek, budget, equipment, editingSkills, consistency, energy }
  roadmap         String   @default("[]") // JSON: [{ quarter, milestones[] }]
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@map("creator_ventures")
}

// ── Unfair Advantage: what combination of skills/experiences/personality is rare
model UnfairAdvantage {
  id          String   @id @default(cuid())
  title       String   // the advantage, e.g. "ML engineer who can teach and has built fintech"
  description String
  components  String   @default("[]") // JSON: [{ type: skill|experience|personality|network|interest, value }]
  rarity      Float    @default(0.5) // 0-1, how rare this combination is
  defensibility Float  @default(0.5) // 0-1, how hard to copy
  monetization Float   @default(0.5) // 0-1, how monetizable
  evidence    String   @default("[]") // JSON: supporting evidence
  createdAt   DateTime @default(now())

  @@map("unfair_advantages")
}

// ── Market Opportunity: a market the creator could enter, with personal fit
model MarketOpportunity {
  id              String   @id @default(cuid())
  niche           String
  audience        String   // target audience
  marketSize      String   @default("medium") // small | medium | large | huge
  competition     String   @default("medium") // low | medium | high | saturated
  difficulty      String   @default("medium") // easy | medium | hard | very_hard
  growthRate      String   @default("stable") // declining | stable | growing | exploding
  monetization    String   @default("medium") // low | medium | high | very_high
  trustPotential  Float    @default(0.5) // 0-1
  longevity       Float    @default(0.5) // 0-1, evergreen vs trendy
  personalFit     Float    @default(0.5) // 0-1, can THIS creator sustainably dominate?
  expectedROI     Float    @default(0.5) // 0-1
  creatorMarketFit Float   @default(0) // computed Creator-Market Fit score (0-100)
  createdAt       DateTime @default(now())

  @@map("market_opportunities")
}

// ── Financial Forecast: scenario-based projections
model FinancialForecast {
  id              String   @id @default(cuid())
  scenario        String   // conservative | expected | aggressive
  horizonMonths   Int      @default(18)
  assumptions     String   @default("{}") // JSON: { videosPerWeek, qualityLevel, retention, targetAudience }
  projections     String   @default("{}") // JSON: { subscribers, monthlyViews, sponsorshipRevenue, affiliateRevenue, courseSales, consultingLeads, arr }
  confidenceLow   String   @default("{}") // JSON: lower bound projections
  confidenceHigh  String   @default("{}") // JSON: upper bound projections
  confidence      Float    @default(0.5) // 0-1
  createdAt       DateTime @default(now())

  @@map("financial_forecasts")
}

// ── Outcome: what the creator is trying to achieve (the optimization target)
model Outcome {
  id          String   @id @default(cuid())
  title       String   // e.g. "Reach 100k subscribers", "Launch ML course", "$20k/month"
  category    String   // audience | revenue | product | authority | community | career
  target      String?  // the measurable target
  deadline    String?  // ISO date or relative ("6 months")
  status      String   @default("active") // active | achieved | abandoned
  progress    Float    @default(0) // 0-1
  priority    String   @default("high") // low | medium | high | critical
  milestones  String   @default("[]") // JSON: [{ title, done }]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@map("outcomes")
}
